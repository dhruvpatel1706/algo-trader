# Alpaca paper credentials — get free at https://alpaca.markets
# v1 is paper-only. Do not put live keys here. Live trading is blocked by guard hook.
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_PAPER_TRADE=True

# Postgres / Redis (matches docker-compose.yml defaults)
POSTGRES_DSN=postgresql+asyncpg://trader:trader@localhost:5433/algotrader
POSTGRES_DSN_SYNC=postgresql+psycopg2://trader:trader@localhost:5433/algotrader
REDIS_URL=redis://localhost:6379/0

# Risk caps — defaults are also enforced in src/risk/limits.py.
# Lowering these is fine; raising them above the defaults will be rejected by config validators.
MAX_PER_TRADE_RISK=0.01
MAX_PORTFOLIO_HEAT=0.06
MAX_SINGLE_POSITION=0.10
DAILY_LOSS_HALT=-0.02
DRAWDOWN_HALT=0.15

# Dashboard
DASHBOARD_API_HOST=0.0.0.0
DASHBOARD_API_PORT=8000
DASHBOARD_WEB_PORT=3000

# Live trading is disabled in v1.
# Setting LIVE_TRADING=1 will be BLOCKED by .claude/hooks/guard_live_order.sh.
LIVE_TRADING=0

# Optional: structured-log level
LOG_LEVEL=INFO
