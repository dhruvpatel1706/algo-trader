# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Operator-private orchestration overrides
CLAUDE.local.md

# Live runtime state
live/state/
live/incidents/
live/locks/

# Journal contents — directory is committed for structure; daily files are not.
journal/*.jsonl
!journal/.gitkeep

# Backtest run artifacts (everything except the README and named sweeps)
backtests/*/
!backtests/README.md
!backtests/mr_etf_sweep/

# Backtest artifacts (large) — but keep sweep result tables under mr_etf_sweep
backtests/**/*.parquet
!backtests/mr_etf_sweep/**/*.parquet
backtests/**/*.png
backtests/**/*.csv

# Data caches
data/cache/
data/cache/**/*.parquet

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Postgres / Redis volumes (compose names them, but in case of bind mounts)
pgdata/
redisdata/
